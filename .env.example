# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://user:password@host:port/database"

PORT=4001
FRONTEND_ORIGIN="http://localhost:5173"

JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="change-me"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloudinary (Documentos clínicos) - credenciales en https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Dimage / RIDS RX (Módulo Rx) - URL base de la API y API key generada en /admin/integraciones
DIMAGE_API_URL=""
DIMAGE_API_KEY=""

# Federación con Dental-Demo-Back (comparte clínicas/pacientes/agenda con el super-admin)
# FEDERATION_API_KEY debe ser el mismo valor en el .env de Dental-Demo-Back.
DENTALDEMO_API_URL=""
FEDERATION_API_KEY=""

# Microsoft Graph API — remitente global compartido (soporte@rids.cl) usado
# como fallback cuando una clínica no tiene su propio correo SMTP configurado
# (ver ClinicaEmailConfig / Configuración > Notificaciones > Correo saliente).
# Mismas credenciales que Dental-Demo-Back (misma app de Azure).
MS_GRAPH_TENANT_ID=""
MS_GRAPH_CLIENT_ID=""
MS_GRAPH_CLIENT_SECRET=""
MS_GRAPH_SENDER=""

# Clave global para cifrar/descifrar la contraseña SMTP de cada clínica
# (AES-256-GCM) — NUNCA se guardan credenciales de clínicas acá, sólo esta
# clave maestra. Generar con: openssl rand -base64 32
EMAIL_ENCRYPTION_KEY=""

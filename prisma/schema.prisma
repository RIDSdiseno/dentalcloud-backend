generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clinica {
  id                         String                      @id @default(uuid())
  name                       String
  active                     Boolean                     @default(true)
  createdAt                  DateTime                    @default(now())
  rxEnabled                  Boolean                     @default(true)
  modules                    Json                        @default("{\"cartola\": true, \"evoluciones\": true, \"observaciones\": true, \"documentosClinicos\": true}")
  tipo                       String                      @default("dental")
  logoUrl                    String?
  logoPublicId               String?
  rut                        String?                     @unique
  rolePermissions            Json                        @default("{}")
  pais                       String                      @default("Chile")
  slotDurationMinutes        Int                         @default(15)
  administrativeObservations AdministrativeObservation[]
  appointments               Appointment[]
  chairs                     Chair[]
  clinicalDocuments          ClinicalDocument[]
  consentTypes               ConsentType[]
  consents                   Consent[]
  convenios                  Convenio[]
  evolutionTemplates         EvolutionTemplate[]
  evolutions                 Evolution[]
  ledgerMovements            LedgerMovement[]
  patients                   Patient[]
  prestaciones               Prestacion[]
  previsiones                Prevision[]
  sucursales                 Sucursal[]
  treatmentItems             TreatmentItem[]
  treatmentItemPhotos        TreatmentItemPhoto[]
  treatmentPlanPhotos        TreatmentPlanPhoto[]
  treatmentPlans             TreatmentPlan[]
  users                      User[]
  workSchedules              WorkSchedule[]

  @@map("clinicas")
}

model User {
  id                                                 String                      @id @default(uuid())
  email                                              String                      @unique
  passwordHash                                       String
  name                                               String
  role                                               String                      @default("odontologo")
  createdAt                                          DateTime                    @default(now())
  updatedAt                                          DateTime                    @updatedAt
  rut                                                String?
  clinicaId                                          String?
  administrativeObservations                         AdministrativeObservation[]
  appointments                                       Appointment[]
  clinicalDocuments                                  ClinicalDocument[]
  consentsSent                                       Consent[]                   @relation("ConsentsSentBy")
  evolutions                                         Evolution[]
  ledgerMovements                                    LedgerMovement[]
  treatment_items                                    TreatmentItem[]
  treatmentPlansCompleted                            TreatmentPlan[]             @relation("TreatmentPlanCompletedBy")
  treatment_plans_treatment_plans_createdByIdTousers TreatmentPlan[]             @relation("treatment_plans_createdByIdTousers")
  treatmentPlansCreated                              TreatmentPlan[]             @relation("TreatmentPlanCreatedBy")
  treatmentPlans                                     TreatmentPlan[]             @relation("TreatmentPlanProfessional")
  treatmentPlansStarted                              TreatmentPlan[]             @relation("TreatmentPlanStartedBy")
  clinica                                            Clinica?                    @relation(fields: [clinicaId], references: [id])
  workSchedules                                      WorkSchedule[]

  @@index([clinicaId])
  @@map("users")
}

model Chair {
  id            String         @id @default(uuid())
  number        Int
  name          String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  clinicaId     String
  appointments  Appointment[]
  clinica       Clinica        @relation(fields: [clinicaId], references: [id])
  workSchedules WorkSchedule[]

  @@unique([clinicaId, number])
  @@map("chairs")
}

model Patient {
  id                         String                      @id @default(uuid())
  rut                        String
  firstName                  String
  lastName                   String
  phone                      String?
  email                      String?
  birthDate                  DateTime?
  address                    String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  clinicaId                  String
  allergies                  String[]                    @default([])
  allergyNotes               String?
  currentMedications         String?
  heightCm                   Int?
  medicalConditions          String?
  weightKg                   Float?
  administrativeObservations AdministrativeObservation[]
  appointments               Appointment[]
  clinicalDocuments          ClinicalDocument[]
  consents                   Consent[]
  evolutions                 Evolution[]
  ledgerMovements            LedgerMovement[]
  clinica                    Clinica                     @relation(fields: [clinicaId], references: [id])
  treatmentPlans             TreatmentPlan[]

  @@unique([clinicaId, rut])
  @@map("patients")
}

model ConsentType {
  id          String    @id @default(uuid())
  code        String
  name        String
  legalText   String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  clinicaId   String
  pdfPublicId String?
  pdfUrl      String?
  clinica     Clinica   @relation(fields: [clinicaId], references: [id])
  consents    Consent[]

  @@unique([clinicaId, code])
  @@map("consent_types")
}

model Consent {
  id              String      @id @default(uuid())
  patientId       String
  consentTypeId   String
  status          String      @default("pendiente")
  method          String?
  token           String?     @unique
  sentAt          DateTime?
  expiresAt       DateTime?
  respondedAt     DateTime?
  signerName      String?
  signerRut       String?
  signerIp        String?
  userAgent       String?
  sentById        String?
  contentSnapshot String?
  clinicaId       String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  pdfSnapshotUrl  String?
  clinica         Clinica     @relation(fields: [clinicaId], references: [id])
  consentType     ConsentType @relation(fields: [consentTypeId], references: [id])
  patient         Patient     @relation(fields: [patientId], references: [id])
  sentBy          User?       @relation("ConsentsSentBy", fields: [sentById], references: [id])

  @@unique([patientId, consentTypeId])
  @@index([clinicaId])
  @@map("consents")
}

model TreatmentPlan {
  id                                       String               @id @default(uuid())
  number                                   Int                  @unique @default(autoincrement())
  patientId                                String
  professionalId                           String?
  status                                   String               @default("sin_iniciar")
  amount                                   Int                  @default(0)
  notes                                    String?
  createdAt                                DateTime             @default(now())
  updatedAt                                DateTime             @updatedAt
  convenioId                               String?
  name                                     String?
  paymentMethod                            String?
  previsionId                              String?
  sucursalId                               String?
  clinicaId                                String
  diagramType                              String               @default("dental")
  createdById                              String?
  facialAnnotations                        Json?
  facialGender                             String?
  createdByUserId                          String?
  startedByUserId                          String?
  startedAt                                DateTime?
  completedByUserId                        String?
  completedAt                              DateTime?
  ledgerMovements                          LedgerMovement[]
  items                                    TreatmentItem[]
  photos                                   TreatmentPlanPhoto[]
  clinica                                  Clinica              @relation(fields: [clinicaId], references: [id])
  completedBy                              User?                @relation("TreatmentPlanCompletedBy", fields: [completedByUserId], references: [id])
  convenio                                 Convenio?            @relation(fields: [convenioId], references: [id])
  users_treatment_plans_createdByIdTousers User?                @relation("treatment_plans_createdByIdTousers", fields: [createdById], references: [id])
  createdBy                                User?                @relation("TreatmentPlanCreatedBy", fields: [createdByUserId], references: [id])
  patient                                  Patient              @relation(fields: [patientId], references: [id])
  prevision                                Prevision?           @relation(fields: [previsionId], references: [id])
  professional                             User?                @relation("TreatmentPlanProfessional", fields: [professionalId], references: [id])
  startedBy                                User?                @relation("TreatmentPlanStartedBy", fields: [startedByUserId], references: [id])
  sucursal                                 Sucursal?            @relation(fields: [sucursalId], references: [id])

  @@index([clinicaId])
  @@index([completedByUserId])
  @@index([createdByUserId])
  @@index([startedByUserId])
  @@map("treatment_plans")
}

model TreatmentPlanPhoto {
  id              String        @id @default(uuid())
  treatmentPlanId String
  url             String
  publicId        String
  label           String?
  position        Int           @default(0)
  createdAt       DateTime      @default(now())
  clinicaId       String
  clinica         Clinica       @relation(fields: [clinicaId], references: [id])
  treatmentPlan   TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)

  @@index([clinicaId])
  @@index([treatmentPlanId])
  @@map("treatment_plan_photos")
}

model TreatmentItem {
  id                      String        @id @default(uuid())
  treatmentPlanId         String
  description             String
  cost                    Int           @default(0)
  completed               Boolean       @default(false)
  createdAt               DateTime      @default(now())
  convenioDiscountPercent Int           @default(0)
  listPrice               Int           @default(0)
  prestacionId            String?
  toothNumber             String?
  clinicaId               String
  notes                   String?
  productName             String?
  productLot              String?
  productExpiresAt        DateTime?
  productQuantity         String?
  treatedAt               DateTime?
  treatedById             String?
  clinica                 Clinica              @relation(fields: [clinicaId], references: [id])
  prestacion              Prestacion?          @relation(fields: [prestacionId], references: [id])
  users                   User?                @relation(fields: [treatedById], references: [id])
  treatmentPlan           TreatmentPlan        @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  photos                  TreatmentItemPhoto[]

  @@index([clinicaId])
  @@index([treatmentPlanId])
  @@map("treatment_items")
}

// Fotografías (ej. antes/después, sticker de lote) asociadas a un
// procedimiento puntual — reconstruido tras un `db push` externo que borró
// esta tabla; ver conversación para el incidente.
model TreatmentItemPhoto {
  id              String        @id @default(uuid())
  treatmentItemId String
  treatmentItem   TreatmentItem @relation(fields: [treatmentItemId], references: [id], onDelete: Cascade)
  url             String
  publicId        String
  label           String?
  createdAt       DateTime      @default(now())
  clinicaId       String
  clinica         Clinica       @relation(fields: [clinicaId], references: [id])

  @@index([clinicaId])
  @@index([treatmentItemId])
  @@map("treatment_item_photos")
}

model Sucursal {
  id             String          @id @default(uuid())
  name           String
  address        String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  dimageClinicId String?
  clinicaId      String
  clinica        Clinica         @relation(fields: [clinicaId], references: [id])
  treatmentPlans TreatmentPlan[]

  @@unique([clinicaId, name])
  @@map("sucursales")
}

model Prevision {
  id             String          @id @default(uuid())
  name           String
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  clinicaId      String
  clinica        Clinica         @relation(fields: [clinicaId], references: [id])
  treatmentPlans TreatmentPlan[]

  @@unique([clinicaId, name])
  @@map("previsiones")
}

model Convenio {
  id              String          @id @default(uuid())
  name            String
  discountPercent Int             @default(0)
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  clinicaId       String
  clinica         Clinica         @relation(fields: [clinicaId], references: [id])
  treatmentPlans  TreatmentPlan[]

  @@unique([clinicaId, name])
  @@map("convenios")
}

model Prestacion {
  id                      String          @id @default(uuid())
  code                    String?
  name                    String
  basePrice               Int             @default(0)
  active                  Boolean         @default(true)
  createdAt               DateTime        @default(now())
  clinicaId               String
  allowedZones            String[]        @default([])
  requiresProductTracking Boolean         @default(false)
  clinica                 Clinica         @relation(fields: [clinicaId], references: [id])
  items                   TreatmentItem[]

  @@unique([clinicaId, code])
  @@map("prestaciones")
}

model Appointment {
  id             String   @id @default(uuid())
  chairId        String
  patientId      String
  startAt        DateTime
  endAt          DateTime
  notes          String?
  status         String   @default("agendada")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  professionalId String?
  type           String   @default("cita")
  clinicaId      String
  chair          Chair    @relation(fields: [chairId], references: [id])
  clinica        Clinica  @relation(fields: [clinicaId], references: [id])
  patient        Patient  @relation(fields: [patientId], references: [id])
  professional   User?    @relation(fields: [professionalId], references: [id])

  @@index([chairId, startAt])
  @@index([professionalId, startAt])
  @@index([clinicaId])
  @@map("appointments")
}

model AdministrativeObservation {
  id             String   @id @default(uuid())
  patientId      String
  professionalId String
  content        String
  createdAt      DateTime @default(now())
  clinicaId      String
  clinica        Clinica  @relation(fields: [clinicaId], references: [id])
  patient        Patient  @relation(fields: [patientId], references: [id])
  professional   User     @relation(fields: [professionalId], references: [id])

  @@index([patientId, createdAt])
  @@index([clinicaId])
  @@map("administrative_observations")
}

model ClinicalDocument {
  id           String   @id @default(uuid())
  patientId    String
  uploadedById String
  category     String
  fileName     String
  fileUrl      String
  resourceType String
  publicId     String
  description  String?
  createdAt    DateTime @default(now())
  clinicaId    String
  clinica      Clinica  @relation(fields: [clinicaId], references: [id])
  patient      Patient  @relation(fields: [patientId], references: [id])
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  @@index([patientId, category, createdAt])
  @@index([clinicaId])
  @@map("clinical_documents")
}

model Evolution {
  id             String   @id @default(uuid())
  patientId      String
  professionalId String
  content        String
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  clinicaId      String
  clinica        Clinica  @relation(fields: [clinicaId], references: [id])
  patient        Patient  @relation(fields: [patientId], references: [id])
  professional   User     @relation(fields: [professionalId], references: [id])

  @@index([patientId, createdAt])
  @@index([clinicaId])
  @@map("evolutions")
}

model EvolutionTemplate {
  id        String   @id @default(uuid())
  name      String
  section   String?
  content   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  clinicaId String
  clinica   Clinica  @relation(fields: [clinicaId], references: [id])

  @@index([clinicaId])
  @@map("evolution_templates")
}

model LedgerMovement {
  id              String         @id @default(uuid())
  number          Int            @unique @default(autoincrement())
  patientId       String
  treatmentPlanId String?
  type            String
  debe            Int            @default(0)
  haber           Int            @default(0)
  description     String?
  paymentMethod   String?
  documentNumber  String?
  notes           String?
  registeredById  String
  createdAt       DateTime       @default(now())
  clinicaId       String
  clinica         Clinica        @relation(fields: [clinicaId], references: [id])
  patient         Patient        @relation(fields: [patientId], references: [id])
  registeredBy    User           @relation(fields: [registeredById], references: [id])
  treatmentPlan   TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id])

  @@index([patientId, createdAt])
  @@index([clinicaId])
  @@map("ledger_movements")
}

model WorkSchedule {
  id             String   @id @default(uuid())
  professionalId String
  chairId        String?
  weekday        Int
  startTime      String
  endTime        String
  createdAt      DateTime @default(now())
  clinicaId      String
  chair          Chair?   @relation(fields: [chairId], references: [id])
  clinica        Clinica  @relation(fields: [clinicaId], references: [id])
  professional   User     @relation(fields: [professionalId], references: [id])

  @@index([professionalId, weekday])
  @@index([clinicaId])
  @@map("work_schedules")
}

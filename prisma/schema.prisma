generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clinica {
  id                         String                      @id @default(uuid())
  name                       String
  active                     Boolean                     @default(true)
  createdAt                  DateTime                    @default(now())
  rxEnabled                  Boolean                     @default(true)
  modules                    Json                        @default("{\"cartola\": true, \"evoluciones\": true, \"observaciones\": true, \"documentosClinicos\": true}")
  tipo                       String                      @default("dental")
  logoUrl                    String?
  logoPublicId               String?
  rut                        String?                     @unique
  rolePermissions            Json                        @default("{}")
  pais                       String                      @default("Chile")
  slotDurationMinutes        Int                         @default(15)
  // Id de la Clinic espejo en Dental-Demo-Back, si esta clínica fue creada (o
  // emparejada) por federación. Null = clínica local, sin par en el otro sistema.
  federatedClinicId          String?                     @unique
  // Emparejamientos retroactivos de clínicas que ya operaban con datos reales
  // (pacientes/citas propios) sólo deben compartir catálogo (convenios,
  // prestaciones, previsiones) — nunca replicar pacientes/citas/presupuestos
  // reales sin que alguien lo pida explícitamente. Si es true, todo el sync
  // de paciente/cita/presupuesto/ítem se omite aunque haya federatedClinicId.
  federationCatalogOnly      Boolean                     @default(false)
  // Pausa manual de la sincronización (desde el panel de Super Admin) sin
  // perder el emparejamiento (federatedClinicId) — a diferencia de
  // desconectar, se puede reanudar en cualquier momento sin re-emparejar.
  federationPaused           Boolean                     @default(false)
  // Switches individuales por tipo de dato (panel de Super Admin) — claves:
  // patients, appointments, treatmentPlans, users, sucursales, catalog. Una
  // clave ausente se trata como `true` (habilitada) para no romper clínicas
  // ya emparejadas antes de que existiera este control granular.
  federationSyncSettings     Json                        @default("{}")
  administrativeObservations AdministrativeObservation[]
  appointments               Appointment[]
  chairs                     Chair[]
  clinicalDocuments          ClinicalDocument[]
  consentTypes               ConsentType[]
  consents                   Consent[]
  consultationPayments       ConsultationPayment[]
  convenios                  Convenio[]
  documentFormats            DocumentFormat[]
  emailConfig                ClinicaEmailConfig?
  insumoSupplies             InsumoSupply[]
  insumoLots                 InsumoLot[]
  insumoLotMovements         InsumoLotMovement[]
  evolutionTemplates         EvolutionTemplate[]
  evolutions                 Evolution[]
  evolutionPhotos            EvolutionPhoto[]
  evolutionDeletions         EvolutionDeletion[]
  ledgerMovements            LedgerMovement[]
  patients                   Patient[]
  prestaciones               Prestacion[]
  previsiones                Prevision[]
  sucursales                 Sucursal[]
  treatmentItemPhotos        TreatmentItemPhoto[]
  treatmentItems             TreatmentItem[]
  treatmentPlanEdits         TreatmentPlanEdit[]
  treatmentPlanPhotos        TreatmentPlanPhoto[]
  treatmentPlans             TreatmentPlan[]
  users                      User[]
  workSchedules              WorkSchedule[]
  openSlots                  OpenSlot[]

  @@map("clinicas")
}

model User {
  id                             String                      @id @default(uuid())
  email                          String                      @unique
  passwordHash                   String
  name                           String
  role                           String                      @default("odontologo")
  createdAt                      DateTime                    @default(now())
  updatedAt                      DateTime                    @updatedAt
  rut                            String?
  clinicaId                      String?
  // Excepciones de permisos/módulos para ESTE usuario puntual, por encima del
  // default de su rol (`Clinica.rolePermissions`) y del plan de la clínica
  // (`Clinica.modules`). Sólo se guardan las llaves explícitamente distintas
  // del default — null/ausente = hereda el default normal. Ver
  // src/lib/userAccessOverrides.ts.
  permissionOverrides            Json?
  moduleOverrides                Json?
  // Firma del profesional, dibujada al crear su cuenta (o después, desde su
  // perfil) — mismo patrón que Consent.signatureUrl/signaturePublicId.
  signatureUrl                   String?
  signaturePublicId              String?
  // Id del User espejo en Dental-Demo-Back, si este profesional fue creado
  // (o emparejado) por federación. Null = profesional local, sin par en el
  // otro sistema.
  federatedUserId                String?                     @unique
  administrativeObservations     AdministrativeObservation[]
  appointments                   Appointment[]               @relation("AppointmentProfessional")
  appointmentsReceived           Appointment[]               @relation("AppointmentReceivedBy")
  clinicalDocuments              ClinicalDocument[]
  consentsSent                   Consent[]                   @relation("ConsentsSentBy")
  consultationPaymentsRegistered ConsultationPayment[]
  evolutions                     Evolution[]
  evolutionDeletions             EvolutionDeletion[]
  ledgerMovements                LedgerMovement[]
  treatmentItemsTreatedBy        TreatmentItem[]
  patientsDataCorroborated       Patient[]
  treatmentPlanEdits             TreatmentPlanEdit[]
  treatmentPlansCompletedBy      TreatmentPlan[]             @relation("TreatmentPlanCompletedBy")
  treatmentPlansCreatedBy        TreatmentPlan[]             @relation("TreatmentPlanCreatedBy")
  treatmentPlansCreatedByLegacy  TreatmentPlan[]             @relation("TreatmentPlanCreatedByLegacy")
  treatmentPlans                 TreatmentPlan[]             @relation("TreatmentPlanProfessional")
  treatmentPlansStartedBy        TreatmentPlan[]             @relation("TreatmentPlanStartedBy")
  clinica                        Clinica?                    @relation(fields: [clinicaId], references: [id])
  workSchedules                  WorkSchedule[]
  openSlots                      OpenSlot[]                  @relation("OpenSlotProfessional")
  openSlotsCreated               OpenSlot[]                  @relation("OpenSlotCreatedBy")
  insumoSuppliesCreatedBy        InsumoSupply[]              @relation("InsumoSupplyCreatedBy")
  insumoSuppliesUpdatedBy        InsumoSupply[]              @relation("InsumoSupplyUpdatedBy")
  insumoLotsCreatedBy            InsumoLot[]                 @relation("InsumoLotCreatedBy")
  insumoLotsUpdatedBy            InsumoLot[]                 @relation("InsumoLotUpdatedBy")
  insumoLotMovementsCreatedBy    InsumoLotMovement[]         @relation("InsumoLotMovementCreatedBy")

  @@index([clinicaId])
  @@map("users")
}

model Chair {
  id            String         @id @default(uuid())
  number        Int
  name          String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  clinicaId     String
  appointments  Appointment[]
  clinica       Clinica        @relation(fields: [clinicaId], references: [id])
  workSchedules WorkSchedule[]
  openSlots     OpenSlot[]

  @@unique([clinicaId, number])
  @@map("chairs")
}

model Patient {
  id                           String                      @id @default(uuid())
  rut                          String
  firstName                    String
  lastName                     String
  phone                        String?
  email                        String?
  birthDate                    DateTime?
  address                      String?
  gender                       String?
  nationality                  String?
  maritalStatus                String?
  occupation                   String?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  healthInsurance              String?
  healthInsuranceDetail        String?
  bloodType                    String?
  tags                         String[]                    @default([])
  photoUrl                     String?
  photoPublicId                String?
  motivoConsulta               String?
  // Grabación de respaldo del motivo de consulta, en la voz del paciente. Solo
  // se puede subir si el paciente ya firmó el consentimiento de tipo
  // 'grabacion_voz' (ver ConsentType/Consent) — se valida en el controlador,
  // no aquí, para no bloquear la creación del paciente en sí.
  motivoConsultaAudioUrl       String?
  motivoConsultaAudioPublicId  String?
  // Corroboración del médico (reunión 2/9 con Urbina): recepción puede cargar
  // los datos administrativos, pero el médico tiene que repasarlos con el
  // paciente presente antes de avanzar — esto queda en null hasta que el
  // profesional presiona "Confirmar datos del paciente" (ver
  // patientsController.ts corroborateData / EstheticWorkflowStepper). Se
  // vuelve a poner en null automáticamente si cambian los datos que ya se
  // habían corroborado, para no dejar una confirmación vieja como válida.
  datosCorroboradosAt          DateTime?
  datosCorroboradosPorId       String?
  // Conclusiones de anamnesis (resumen automático se arma en el frontend a
  // partir de los campos clínicos ya existentes, no se guarda como texto).
  expectativasPaciente         String?
  optimoTratamiento            String?
  // Examen estético.
  examSkinType                 String?
  examFitzpatrick              String?
  examWrinkles                 String?
  examFlaccidity               String?
  examVolume                   String?
  examAsymmetries              Boolean?
  examAsymmetryNotes           String?
  examDiagnosis                String?
  examPhotoFrontalUrl          String?
  examPhotoPerfilDerechoUrl    String?
  examPhoto45DerechaUrl        String?
  examPhoto45IzquierdaUrl      String?
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt
  clinicaId                    String
  // Id del Patient espejo en Dental-Demo-Back, si la clínica de este paciente
  // está emparejada por federación. Null = paciente sin espejo (aún, o porque
  // su clínica no está emparejada).
  federatedPatientId           String?                     @unique
  allergies                    String[]                    @default([])
  allergyNotes                 String?
  currentMedications           String?
  heightCm                     Int?
  medicalConditions            String?
  weightKg                     Float?
  chronicDiseases              String?
  dentalHistory                String?
  administrativeObservations   AdministrativeObservation[]
  appointments                 Appointment[]
  clinicalDocuments            ClinicalDocument[]
  consents                     Consent[]
  evolutions                   Evolution[]
  evolutionDeletions           EvolutionDeletion[]
  ledgerMovements              LedgerMovement[]
  clinica                      Clinica                     @relation(fields: [clinicaId], references: [id])
  treatmentPlans               TreatmentPlan[]
  datosCorroboradosPor         User?                       @relation(fields: [datosCorroboradosPorId], references: [id])

  @@unique([clinicaId, rut])
  @@map("patients")
}

model ConsentType {
  id          String    @id @default(uuid())
  code        String
  name        String
  legalText   String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  clinicaId   String
  pdfPublicId String?
  pdfUrl      String?
  clinica     Clinica   @relation(fields: [clinicaId], references: [id])
  consents    Consent[]

  @@unique([clinicaId, code])
  @@map("consent_types")
}

model Consent {
  id                String      @id @default(uuid())
  patientId         String
  consentTypeId     String
  status            String      @default("pendiente")
  method            String?
  token             String?     @unique
  sentAt            DateTime?
  expiresAt         DateTime?
  respondedAt       DateTime?
  signerName        String?
  signerRut         String?
  signerIp          String?
  userAgent         String?
  sentById          String?
  contentSnapshot   String?
  clinicaId         String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  pdfSnapshotUrl    String?
  signaturePublicId String?
  signatureUrl      String?
  clinica           Clinica     @relation(fields: [clinicaId], references: [id])
  consentType       ConsentType @relation(fields: [consentTypeId], references: [id])
  patient           Patient     @relation(fields: [patientId], references: [id])
  sentBy            User?       @relation("ConsentsSentBy", fields: [sentById], references: [id])

  @@unique([patientId, consentTypeId])
  @@index([clinicaId])
  @@map("consents")
}

model TreatmentPlan {
  id                       String               @id @default(uuid())
  number                   Int                  @unique @default(autoincrement())
  patientId                String
  professionalId           String?
  status                   String               @default("sin_iniciar")
  amount                   Int                  @default(0)
  notes                    String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  convenioId               String?
  name                     String?
  paymentMethod            String?
  previsionId              String?
  sucursalId               String?
  clinicaId                String
  diagramType              String               @default("dental")
  createdById              String?
  facialAnnotations        Json?
  facialGender             String?
  createdByUserId          String?
  startedByUserId          String?
  startedAt                DateTime?
  completedByUserId        String?
  completedAt              DateTime?
  // Id del TreatmentPlan espejo en Dental-Demo-Back, si el paciente de este
  // presupuesto está emparejado por federación.
  federatedTreatmentPlanId String?              @unique
  // Nombre del profesional a cargo, sólo cuando este plan nació en
  // Dental-Demo-Back — no hay federación de cuentas de staff entre ambos
  // sistemas, así que no existe un `professionalId` real que enlazar; se
  // guarda el nombre como texto puramente informativo (ver `professional`
  // para el vínculo real cuando el plan nació en esta misma plataforma).
  remoteProfessionalName   String?
  ledgerMovements          LedgerMovement[]
  items                    TreatmentItem[]
  photos                   TreatmentPlanPhoto[]
  edits                    TreatmentPlanEdit[]
  clinica                  Clinica              @relation(fields: [clinicaId], references: [id])
  completedBy              User?                @relation("TreatmentPlanCompletedBy", fields: [completedByUserId], references: [id])
  convenio                 Convenio?            @relation(fields: [convenioId], references: [id])
  createdBy                User?                @relation("TreatmentPlanCreatedBy", fields: [createdById], references: [id])
  createdByLegacy          User?                @relation("TreatmentPlanCreatedByLegacy", fields: [createdByUserId], references: [id])
  patient                  Patient              @relation(fields: [patientId], references: [id])
  prevision                Prevision?           @relation(fields: [previsionId], references: [id])
  professional             User?                @relation("TreatmentPlanProfessional", fields: [professionalId], references: [id])
  startedBy                User?                @relation("TreatmentPlanStartedBy", fields: [startedByUserId], references: [id])
  sucursal                 Sucursal?            @relation(fields: [sucursalId], references: [id])

  @@index([clinicaId])
  @@map("treatment_plans")
}

model TreatmentPlanPhoto {
  id              String        @id @default(uuid())
  treatmentPlanId String
  url             String
  publicId        String
  label           String?
  position        Int           @default(0)
  createdAt       DateTime      @default(now())
  clinicaId       String
  clinica         Clinica       @relation(fields: [clinicaId], references: [id])
  treatmentPlan   TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)

  @@index([clinicaId])
  @@index([treatmentPlanId])
  @@map("treatment_plan_photos")
}

// Motivo de cada modificación a un presupuesto ya "en tratamiento" — quién y
// por qué agregó nuevas prestaciones a algo que ya se empezó a tratar (pedido
// explícito de auditoría, no solo una confirmación en pantalla). Una fila por
// cada vez que se modifica, no un solo campo que se sobrescriba.
model TreatmentPlanEdit {
  id              String        @id @default(uuid())
  treatmentPlanId String
  reason          String
  userId          String
  createdAt       DateTime      @default(now())
  clinicaId       String
  clinica         Clinica       @relation(fields: [clinicaId], references: [id])
  treatmentPlan   TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id])

  @@index([clinicaId])
  @@index([treatmentPlanId])
  @@map("treatment_plan_edits")
}

model TreatmentItem {
  id                       String               @id @default(uuid())
  treatmentPlanId          String
  description              String
  cost                     Int                  @default(0)
  completed                Boolean              @default(false)
  createdAt                DateTime             @default(now())
  convenioDiscountPercent  Int                  @default(0)
  listPrice                Int                  @default(0)
  prestacionId             String?
  toothNumber              String?
  clinicaId                String
  notes                    String?
  productName              String?
  productLot               String?
  productExpiresAt         DateTime?
  productQuantity          String?
  treatedAt                DateTime?
  // Id del TreatmentPlanItem espejo en Dental-Demo-Back.
  federatedTreatmentItemId String?              @unique
  treatedById              String?
  photos                   TreatmentItemPhoto[]
  evolutions               Evolution[]
  clinica                  Clinica              @relation(fields: [clinicaId], references: [id])
  prestacion               Prestacion?          @relation(fields: [prestacionId], references: [id])
  treatedBy                User?                @relation(fields: [treatedById], references: [id])
  treatmentPlan            TreatmentPlan        @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)

  @@index([clinicaId])
  @@index([treatmentPlanId])
  @@map("treatment_items")
}

model TreatmentItemPhoto {
  id              String        @id @default(uuid())
  treatmentItemId String
  url             String
  publicId        String
  label           String?
  createdAt       DateTime      @default(now())
  clinicaId       String
  clinica         Clinica       @relation(fields: [clinicaId], references: [id])
  treatmentItem   TreatmentItem @relation(fields: [treatmentItemId], references: [id], onDelete: Cascade)

  @@index([clinicaId])
  @@index([treatmentItemId])
  @@map("treatment_item_photos")
}

model Sucursal {
  id                  String              @id @default(uuid())
  name                String
  address             String?
  active              Boolean             @default(true)
  createdAt           DateTime            @default(now())
  dimageClinicId      String?
  clinicaId           String
  // Id de la Location espejo en Dental-Demo-Back, si esta sucursal fue
  // creada (o emparejada) por federación. Null = sucursal local, sin par en
  // el otro sistema.
  federatedSucursalId String?             @unique
  clinica             Clinica             @relation(fields: [clinicaId], references: [id])
  treatmentPlans      TreatmentPlan[]
  insumoSupplies      InsumoSupply[]
  insumoLots          InsumoLot[]
  insumoLotMovements  InsumoLotMovement[]

  @@unique([clinicaId, name])
  @@map("sucursales")
}

model Prevision {
  id                   String          @id @default(uuid())
  name                 String
  active               Boolean         @default(true)
  createdAt            DateTime        @default(now())
  clinicaId            String
  // Id del Prevision espejo en Dental-Demo-Back, si esta clínica está
  // emparejada por federación. Null = previsión local, sin par en el otro sistema.
  federatedPrevisionId String?         @unique
  clinica              Clinica         @relation(fields: [clinicaId], references: [id])
  treatmentPlans       TreatmentPlan[]

  @@unique([clinicaId, name])
  @@map("previsiones")
}

model Convenio {
  id                  String          @id @default(uuid())
  name                String
  discountPercent     Int             @default(0)
  active              Boolean         @default(true)
  createdAt           DateTime        @default(now())
  clinicaId           String
  // Id del ClinicAgreement espejo en Dental-Demo-Back, si esta clínica está
  // emparejada por federación. Null = convenio local, sin par en el otro sistema.
  federatedConvenioId String?         @unique
  clinica             Clinica         @relation(fields: [clinicaId], references: [id])
  treatmentPlans      TreatmentPlan[]

  @@unique([clinicaId, name])
  @@map("convenios")
}

model Prestacion {
  id                      String          @id @default(uuid())
  code                    String?
  name                    String
  basePrice               Int             @default(0)
  active                  Boolean         @default(true)
  // "dental" | "estetica" — sólo relevante para elegir si esta prestación
  // puntual usa el odontograma o el mapa facial en clínicas tipo "ambas".
  category                String          @default("dental")
  // Modo de selección del odontograma para esta prestación (sólo aplica si
  // category = "dental"): 'session' | 'tooth' | 'surface' | 'extraction' |
  // 'cuadrante' | 'sextante' | 'arcada'. Ver OdontogramMode en el front.
  // Se sugiere automáticamente por palabras clave del nombre al crear/editar
  // (ver odontogramConfig.ts), pero queda guardado y editable — deja de
  // depender de adivinar el modo cada vez que se muestra el odontograma.
  odontogramMode          String          @default("tooth")
  createdAt               DateTime        @default(now())
  clinicaId               String
  allowedZones            String[]        @default([])
  requiresProductTracking Boolean         @default(false)
  // Aplica siempre al rostro completo (ej. limpieza facial) — al elegirla en
  // un presupuesto no hace falta marcar ninguna zona (equivale al modo
  // "sesión" del mapa facial, ver facialZoneConfig.ts). Si se marca, no tiene
  // sentido además restringir `allowedZones` — el catálogo lo oculta.
  appliesToWholeFace      Boolean         @default(false)
  // Cuando `allowedZones` tiene 2 o más zonas, decide cómo se usan: si es
  // true, el tratamiento va siempre en TODAS esas zonas juntas (se
  // preseleccionan solas, sin clic); si es false (default), son un menú de
  // opciones y el profesional elige cuáles aplican cada vez. Sin efecto con 0
  // o 1 zona (sin restricción no aplica; con una sola no hay ambigüedad).
  zonesApplyTogether      Boolean         @default(false)
  // Precio distinto por zona (ej. Botox: Cuello $X, Frente $Y, Mentón $Z) —
  // JSON { [zona]: precio }. Solo tiene efecto con 2+ `allowedZones`; null o
  // vacío = comportamiento de siempre, un solo `basePrice` sin importar la
  // zona (pensado para "un mismo implemento cubre varias zonas en la misma
  // sesión"). Si se define, cada zona DEBE tener su precio — el catálogo lo
  // valida. El costo de un ítem con 2+ zonas elegidas se calcula sumando el
  // precio de cada una (ver TreatmentPlanFormModal.tsx).
  zonePrices              Json?
  // Id del Prestacion espejo en Dental-Demo-Back, si esta clínica está
  // emparejada por federación. Null = prestación local, sin par en el otro sistema.
  federatedPrestacionId   String?         @unique
  clinica                 Clinica         @relation(fields: [clinicaId], references: [id])
  items                   TreatmentItem[]

  @@unique([clinicaId, code])
  @@map("prestaciones")
}

model Appointment {
  id                     String    @id @default(uuid())
  chairId                String
  patientId              String
  startAt                DateTime
  endAt                  DateTime
  notes                  String?
  status                 String    @default("agendada")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  professionalId         String?
  type                   String    @default("cita")
  clinicaId              String
  // Hitos de los Circuitos del Paciente: se llenan al presionar los botones
  // "Marcar llegada" y "Pasar a atención". Habilitan métricas de puntualidad,
  // tiempo de espera y tiempo en atención sin pedirle un campo nuevo al doctor.
  arrivedAt              DateTime?
  attentionStartedAt     DateTime?
  attentionEndedAt       DateTime?
  // Datos propios del circuito de Urgencia — solo se llenan cuando
  // type === "urgencia". No requieren su propia tabla: una urgencia usa el
  // mismo circuito clínico (llego → en_atencion → finalizada) que cualquier
  // cita, solo entra sin agenda previa y con estos datos adicionales.
  motivoUrgencia         String?
  triageLevel            String?
  receivedByUserId       String?
  // Id del Appointment espejo en Dental-Demo-Back, si esta cita fue creada (o
  // sincronizada) por federación.
  federatedAppointmentId String?   @unique
  chair                  Chair     @relation(fields: [chairId], references: [id])
  clinica                Clinica   @relation(fields: [clinicaId], references: [id])
  patient                Patient   @relation(fields: [patientId], references: [id])
  professional           User?     @relation("AppointmentProfessional", fields: [professionalId], references: [id])
  receivedBy             User?     @relation("AppointmentReceivedBy", fields: [receivedByUserId], references: [id])
  // Presente solo si esta cita nació de tomar una hora publicada ("Agregar
  // horas disponibles") — al cancelar la cita, se usa para reabrir esa hora.
  openSlot               OpenSlot?

  @@index([chairId, startAt])
  @@index([professionalId, startAt])
  @@index([clinicaId])
  @@map("appointments")
}

model AdministrativeObservation {
  id             String   @id @default(uuid())
  patientId      String
  professionalId String
  content        String
  createdAt      DateTime @default(now())
  clinicaId      String
  clinica        Clinica  @relation(fields: [clinicaId], references: [id])
  patient        Patient  @relation(fields: [patientId], references: [id])
  professional   User     @relation(fields: [professionalId], references: [id])

  @@index([patientId, createdAt])
  @@index([clinicaId])
  @@map("administrative_observations")
}

model ClinicalDocument {
  id           String   @id @default(uuid())
  patientId    String
  uploadedById String
  category     String
  fileName     String
  fileUrl      String
  resourceType String
  publicId     String
  description  String?
  createdAt    DateTime @default(now())
  clinicaId    String
  clinica      Clinica  @relation(fields: [clinicaId], references: [id])
  patient      Patient  @relation(fields: [patientId], references: [id])
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  @@index([patientId, category, createdAt])
  @@index([clinicaId])
  @@map("clinical_documents")
}

model Evolution {
  id               String           @id @default(uuid())
  patientId        String
  professionalId   String
  content          String
  enabled          Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  clinicaId        String
  // Procedimiento del presupuesto que esta evolución documenta (opcional —
  // una evolución también puede ser una nota clínica general, sin ítem
  // asociado). Al crearla con este campo, el ítem se marca automáticamente
  // como realizado (ver evolutionsController.ts) — mismo campo `treatedBy`/
  // `treatedAt` que ya existe si se marca a mano con el checkbox.
  treatmentItemId  String?
  // Trazabilidad del producto usado, documentada en el momento de evolucionar
  // (no al presupuestar) — el presupuesto puede venir de otro sistema (aún
  // por integrar); lo que realmente se hizo/usó se registra acá. Si hay
  // `treatmentItemId`, se copia también al ítem para no romper vistas que
  // todavía leen desde ahí (ver evolutionsController.ts).
  productName      String?
  productLot       String?
  productExpiresAt DateTime?
  productQuantity  String?
  clinica          Clinica          @relation(fields: [clinicaId], references: [id])
  patient          Patient          @relation(fields: [patientId], references: [id])
  professional     User             @relation(fields: [professionalId], references: [id])
  treatmentItem    TreatmentItem?   @relation(fields: [treatmentItemId], references: [id])
  photos           EvolutionPhoto[]

  @@index([patientId, createdAt])
  @@index([clinicaId])
  @@index([treatmentItemId])
  @@map("evolutions")
}

// Fotos (antes/después, sticker de lote) tomadas al evolucionar — mismo
// patrón que TreatmentItemPhoto, pero la Evolución es ahora el lugar
// "oficial" donde documentar lo que realmente se hizo.
model EvolutionPhoto {
  id          String    @id @default(uuid())
  evolutionId String
  evolution   Evolution @relation(fields: [evolutionId], references: [id], onDelete: Cascade)
  url         String
  publicId    String
  label       String?
  createdAt   DateTime  @default(now())
  clinicaId   String
  clinica     Clinica   @relation(fields: [clinicaId], references: [id])

  @@index([clinicaId])
  @@index([evolutionId])
  @@map("evolution_photos")
}

// Registro de auditoría al borrar una evolución (pedido explícito: se puede
// borrar, pero solo dando un motivo, y queda trazabilidad de qué decía y
// quién la borró). Sin relación formal hacia `Evolution` porque esa fila ya
// no va a existir — se guarda una copia (`content`) al momento de borrar.
model EvolutionDeletion {
  id              String   @id @default(uuid())
  evolutionId     String
  patientId       String
  professionalId  String
  content         String
  reason          String
  deletedByUserId String
  clinicaId       String
  createdAt       DateTime @default(now())
  clinica         Clinica  @relation(fields: [clinicaId], references: [id])
  patient         Patient  @relation(fields: [patientId], references: [id])
  deletedBy       User     @relation(fields: [deletedByUserId], references: [id])

  @@index([clinicaId])
  @@index([patientId])
  @@map("evolution_deletions")
}

model EvolutionTemplate {
  id        String   @id @default(uuid())
  name      String
  section   String?
  content   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  clinicaId String
  clinica   Clinica  @relation(fields: [clinicaId], references: [id])

  @@index([clinicaId])
  @@map("evolution_templates")
}

model LedgerMovement {
  id                String         @id @default(uuid())
  number            Int            @unique @default(autoincrement())
  patientId         String
  treatmentPlanId   String?
  type              String
  debe              Int            @default(0)
  haber             Int            @default(0)
  description       String?
  paymentMethod     String?
  documentNumber    String?
  notes             String?
  registeredById    String
  createdAt         DateTime       @default(now())
  clinicaId         String
  // Id del ClinicIncome de Dental-Demo-Back que originó este movimiento,
  // cuando viene de un abono registrado allá (Pagos de Consulta/Presupuesto
  // conectado) — permite upsert idempotente desde mirrorLedgerMovement sin
  // duplicar en reintentos. Null para movimientos creados a mano en la
  // Cartola de DentalCloud.
  federatedIncomeId String?        @unique
  clinica           Clinica        @relation(fields: [clinicaId], references: [id])
  patient           Patient        @relation(fields: [patientId], references: [id])
  registeredBy      User           @relation(fields: [registeredById], references: [id])
  treatmentPlan     TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id])

  @@index([patientId, createdAt])
  @@index([clinicaId])
  @@map("ledger_movements")
}

model WorkSchedule {
  id             String   @id @default(uuid())
  professionalId String
  chairId        String?
  weekday        Int
  startTime      String
  endTime        String
  createdAt      DateTime @default(now())
  clinicaId      String
  chair          Chair?   @relation(fields: [chairId], references: [id])
  clinica        Clinica  @relation(fields: [clinicaId], references: [id])
  professional   User     @relation(fields: [professionalId], references: [id])

  @@index([professionalId, weekday])
  @@index([clinicaId])
  @@map("work_schedules")
}

// Hora puntual que un profesional (o el administrador, a nombre de un
// profesional) publica desde su Agenda diaria como disponible — "Agregar
// horas disponibles". Mientras esté 'abierta', el portal de pacientes la
// ofrece para agendar; al tomarse (por el staff desde "Nueva cita" o por el
// paciente desde el portal) nace una Appointment real y esta queda 'tomada'.
// Si esa cita se cancela después, esta hora vuelve a quedar 'abierta'.
model OpenSlot {
  id              String       @id @default(uuid())
  clinicaId       String
  chairId         String
  professionalId  String
  startAt         DateTime
  endAt           DateTime
  status          String       @default("abierta")
  createdByUserId String
  appointmentId   String?      @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  clinica         Clinica      @relation(fields: [clinicaId], references: [id])
  chair           Chair        @relation(fields: [chairId], references: [id])
  professional    User         @relation("OpenSlotProfessional", fields: [professionalId], references: [id])
  createdBy       User         @relation("OpenSlotCreatedBy", fields: [createdByUserId], references: [id])
  appointment     Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([clinicaId, professionalId, startAt])
  @@index([chairId, startAt])
  @@map("open_slots")
}

// Cola de reintento para escrituras de federación (hacia Dental-Demo-Back)
// que fallaron. Sin infraestructura de colas nueva: un intervalo en el
// proceso (ver src/lib/federationRetry.ts) barre esta tabla periódicamente.
model FederationSyncFailure {
  id         String   @id @default(uuid())
  entityType String
  localId    String
  payload    Json
  lastError  String?
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, localId])
  @@map("federation_sync_failures")
}

// Plantillas de documentos configurables por clínica (Configuración >
// Formatos): presupuesto, exámenes, plan de tratamiento, receta. `body` es
// texto simple por ahora (no HTML/PDF real todavía).
model DocumentFormat {
  id        String   @id @default(uuid())
  clinicaId String
  name      String
  type      String
  body      String   @default("") @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinica   Clinica  @relation(fields: [clinicaId], references: [id])

  @@index([clinicaId])
  @@map("document_formats")
}

// Registro de pagos de consulta (previo a la atención) — apartado aparte, no
// ligado a la ficha de un paciente. Solo sirve para que el personal vea
// quién pagó y decida a mano si atenderlo; no bloquea nada del sistema.
// Si el RUT coincide con uno acá al crear un paciente nuevo, se usa para
// autocompletar nombre y correo (ver patientsController).
model ConsultationPayment {
  id             String   @id @default(uuid())
  clinicaId      String
  rut            String
  firstName      String
  lastName       String
  email          String?
  amount         Int
  paymentMethod  String?
  registeredById String
  createdAt      DateTime @default(now())
  clinica        Clinica  @relation(fields: [clinicaId], references: [id])
  registeredBy   User     @relation(fields: [registeredById], references: [id])

  @@index([clinicaId])
  @@index([clinicaId, rut])
  @@map("consultation_payments")
}

// Correo saliente propio de la clínica (holding) — si existe y está
// `enabled`, el correo de confirmación de citas se envía por SMTP con estas
// credenciales en vez del remitente global compartido (soporte@rids.cl vía
// Microsoft Graph). `smtpPasswordEncrypted` nunca se expone al frontend tal
// cual — ver src/lib/emailCrypto.ts y emailSettingsController.ts.
model ClinicaEmailConfig {
  id                    String   @id @default(uuid())
  clinicaId             String   @unique
  provider              String   @default("smtp")
  smtpHost              String?
  smtpPort              Int?
  smtpSecure            Boolean  @default(true)
  smtpUsername          String?
  smtpPasswordEncrypted String?
  fromEmail             String?
  fromName              String?
  enabled               Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  clinica               Clinica  @relation(fields: [clinicaId], references: [id])

  @@map("clinica_email_configs")
}

// Inventario nativo de la clínica — usado como fallback cuando la clínica NO
// está federada con Dental-Demo-Back (ver isClinicaFederatedForInventory en
// inventoryController.ts). Las clínicas SÍ federadas siguen usando el relay
// en vivo hacia Dental-Demo-Back (federationClient.ts), sin tocar estas
// tablas — no hay sincronización entre ambos caminos hoy.
model InsumoSupply {
  id              String  @id @default(uuid())
  clinicaId       String
  sucursalId      String?
  createdByUserId String
  updatedByUserId String?

  name           String
  category       String?
  supplier       String?
  consultingRoom String?
  description    String?
  // Para qué tipo de tratamiento se usa este insumo — mismo criterio que el
  // clinicalArea que el compañero agregó del lado de Dental-Demo-Back.
  // ESTHETIC/BOTH solo se permite si Clinica.tipo es "estetica" o "ambas"
  // (ver assertClinicalAreaAllowed en insumoSupply.service.ts) — acá no hay
  // un flag de módulo separado como en Dental-Demo-Back, se usa el mismo tipo
  // de clínica que ya gatea el resto de las funciones de estética.
  clinicalArea   InsumoClinicalArea @default(DENTAL)

  purchaseDate DateTime?
  quantity     Float?
  unit         String?
  unitCost     Int?
  totalCost    Int?
  // Siempre recalculado desde la suma de lotes activos (ver
  // insumoLot.service.ts syncSupplyStockFromLots) — nunca confiar en un
  // valor manual una vez el insumo tiene lotes.
  currentStock Float?
  minimumStock Float?

  status     InsumoSupplyStatus @default(ACTIVE)
  archivedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  clinica   Clinica             @relation(fields: [clinicaId], references: [id])
  sucursal  Sucursal?           @relation(fields: [sucursalId], references: [id], onDelete: SetNull)
  createdBy User                @relation("InsumoSupplyCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy User?               @relation("InsumoSupplyUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  lots      InsumoLot[]
  movements InsumoLotMovement[]

  @@index([clinicaId])
  @@index([clinicaId, sucursalId])
  @@index([clinicaId, status])
  @@map("insumo_supplies")
}

enum InsumoSupplyStatus {
  ACTIVE
  LOW_STOCK
  OUT_OF_STOCK
  ARCHIVED
}

enum InsumoClinicalArea {
  DENTAL
  ESTHETIC
  BOTH
}

model InsumoLot {
  id              String  @id @default(uuid())
  clinicaId       String
  supplyId        String
  sucursalId      String?
  createdByUserId String
  updatedByUserId String?

  lotNumber          String
  manufacturer       String?
  presentation       String?
  concentration      String?
  healthRegistration String?
  receivedAt         DateTime?
  expiresAt          DateTime?
  initialQuantity    Float
  // Balance vivo, mutado solo por movimientos (ver
  // insumoLot.service.ts createInsumoLotMovement).
  currentQuantity    Float
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  clinica   Clinica             @relation(fields: [clinicaId], references: [id])
  supply    InsumoSupply        @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  sucursal  Sucursal?           @relation(fields: [sucursalId], references: [id], onDelete: SetNull)
  createdBy User                @relation("InsumoLotCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy User?               @relation("InsumoLotUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  movements InsumoLotMovement[]

  @@unique([supplyId, lotNumber])
  @@index([clinicaId])
  @@index([clinicaId, expiresAt])
  @@map("insumo_lots")
}

model InsumoLotMovement {
  id              String  @id @default(uuid())
  clinicaId       String
  supplyId        String
  lotId           String
  sucursalId      String?
  createdByUserId String

  movementType      InsumoMovementType
  quantity          Float
  previousQuantity  Float
  resultingQuantity Float
  reason            String?
  createdAt         DateTime           @default(now())

  clinica   Clinica      @relation(fields: [clinicaId], references: [id])
  supply    InsumoSupply @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  lot       InsumoLot    @relation(fields: [lotId], references: [id], onDelete: Cascade)
  createdBy User         @relation("InsumoLotMovementCreatedBy", fields: [createdByUserId], references: [id])
  sucursal  Sucursal?    @relation(fields: [sucursalId], references: [id])

  @@index([clinicaId])
  @@index([lotId, createdAt])
  @@map("insumo_lot_movements")
}

enum InsumoMovementType {
  IN
  OUT
  ADJUSTMENT
}
